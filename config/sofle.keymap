#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | [ (Х) |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   | ' (Э) |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  | |        |  N   |  M    |  ,    |  .   |   /   | ] (Ъ) |
//               | GUI | ALT  | CTRL | LOWER|  SPACE | | ENTER | RAISE| BKSPC |  DEL  | GUI  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                      &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T                       &kp Y  &kp U    &kp I     &kp O   &kp P    &kp LBKT
&kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G                       &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE &none     &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RBKT
                 &kp LGUI &kp LALT &kp LCTRL &mo 1  &kp SPACE     &kp RET  &mo 2 &kp BSPC &kp DEL &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |     |     |      |      |      |                   |  /   |   7   |   8   |  9   |   -   |  F12  |
// |       |     |     |      |      |      |                   |  *   |   4   |   5   |  6   |   +   |   =   |
// |       |     |     |      |      |      |        | |        |  0   |   1   |   2   |  3   |   .   |   \   |
//               |     |      |      |      |        | |        |      |       |       |      |
            bindings = <
&kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                      &kp F6   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
&trans    &trans &trans &trans &trans &trans                      &kp FSLH &kp N7 &kp N8 &kp N9 &kp MINUS &kp F12
&trans    &trans &trans &trans &trans &trans                      &kp STAR &kp N4 &kp N5 &kp N6 &kp PLUS  &kp EQUAL
&trans    &trans &trans &trans &trans &trans &trans       &trans  &kp N0   &kp N1 &kp N2 &kp N3 &kp DOT   &kp BSLH
                 &trans &trans &trans &trans &trans       &trans  &trans   &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 | BT3  | BT4  | BT5  |                   |      |       |       |      |       | BLOAD |
// |       |     | Prev| Play | Next |      |                   |      |       |       |      |       |       |
// |       |     | Vol-| Vol+ | Mute |      |                   |  <-  |   v   |   ^   |  ->  |       |       |
// |       |     |     |      |      |      |        | |        |      |       |       |      |       |       |
//               |     |      |      |      |        | |        |      |       |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4             &trans   &trans   &trans &trans    &trans &bootloader
&trans     &trans       &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans                   &trans   &trans   &trans &trans    &trans &trans
&trans     &trans       &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &trans                   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans &trans     &trans &trans   &trans   &trans &trans    &trans &trans
                        &trans       &trans       &trans       &trans &trans     &trans &trans   &trans   &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
